<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FF222222">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/title_text"
        android:text="HF Band Conditions"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/updated_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:textSize="@dimen/label_text"
        android:textColor="#FFC107"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Band"
            android:textSize="@dimen/label_text"
            android:textStyle="bold"
            android:textColor="#AAAAAA" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Day"
            android:textSize="@dimen/label_text"
            android:textStyle="bold"
            android:textColor="#AAAAAA"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Night"
            android:textSize="@dimen/label_text"
            android:textStyle="bold"
            android:textColor="#AAAAAA"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF444444"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="80m-40m"
            android:textSize="@dimen/label_text"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/band_80m40m_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@+id/band_80m40m_night"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF444444"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="30m-20m"
            android:textSize="@dimen/label_text"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/band_30m20m_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@+id/band_30m20m_night"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF444444"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="17m-15m"
            android:textSize="@dimen/label_text"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/band_17m15m_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@+id/band_17m15m_night"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF444444"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12m-10m"
            android:textSize="@dimen/label_text"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/band_12m10m_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@+id/band_12m10m_night"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textStyle="bold"
            android:textSize="@dimen/value_text"
            android:textColor="#FFFFFF"
            android:gravity="end" />
    </LinearLayout>

</LinearLayout>
